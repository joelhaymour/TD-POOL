# Copy to .env.local and fill secrets

NEXT_PUBLIC_SUPABASE_URL=https://yzqdawphpjxarctbggxl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Use hosted Supabase when true (anon key works for MVP with open RLS)
USE_SUPABASE=false

# mock | auto | live
PROVIDER_MODE=auto
NFL_PROVIDER=espn

# https://the-odds-api.com — Anytime TD market quotes
ODDS_API_KEY=
ODDS_API_REGIONS=us

# Optional primary football data (depth charts, RZ, injuries)
# Free trial (scrambled) or production key: https://sportsdata.io/cart/free-trial/nfl
SPORTSDATAIO_API_KEY=

# Optional secondary projection signal (architecture ready; unused until key + plan)
FANTASYPROS_API_KEY=

# AI writeups — prefer Vercel AI Gateway (no direct OpenAI key needed on Vercel)
# 1) Enable AI Gateway on the project in the Vercel dashboard
# 2) Create a key at https://vercel.com/dashboard → AI Gateway → API Keys
#    or: npx vercel ai-gateway api-keys create --name td-pool
# 3) Set AI_GATEWAY_API_KEY locally + in Vercel (Production / Preview / Development)
AI_GATEWAY_API_KEY=
# Model slug for AI Gateway (provider/model)
OPENAI_MODEL=openai/gpt-5.4-mini
# Legacy direct OpenAI (not preferred — bypasses Gateway)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Protect /api/cron/refresh-td-board
CRON_SECRET=
