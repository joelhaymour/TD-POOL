# Copy to .env.local and fill secrets

NEXT_PUBLIC_SUPABASE_URL=https://yzqdawphpjxarctbggxl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Use hosted Supabase when true (anon key works for MVP with open RLS)
USE_SUPABASE=false

# mock | auto | live
PROVIDER_MODE=auto
NFL_PROVIDER=espn

# https://the-odds-api.com — Anytime TD market quotes
ODDS_API_KEY=
ODDS_API_REGIONS=us

# Optional primary football data (schedule/stats/RZ/depth/injuries)
# https://sportsdata.io
SPORTSDATAIO_API_KEY=

# Optional secondary projection signal (architecture ready; unused until key + plan)
FANTASYPROS_API_KEY=

# Optional AI explanation layer (numeric model never depends on this)
OPENAI_API_KEY=
# Or Vercel AI Gateway
AI_GATEWAY_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=openai/gpt-4.1-mini

# Protect /api/cron/refresh-td-board
CRON_SECRET=
