NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# mock | auto | live  (auto uses The Odds API when ODDS_API_KEY is set)
PROVIDER_MODE=auto

# https://the-odds-api.com — leave empty to run on mock anytime-TD odds
ODDS_API_KEY=
ODDS_API_REGIONS=us

USE_SUPABASE=false
