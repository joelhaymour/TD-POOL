{
  "name": "td-pool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test:environment": "node --test scripts/environment.test.mjs",
    "db:v2:plan": "node scripts/db-v2.mjs plan",
    "db:v2:push": "node scripts/db-v2.mjs push",
    "db:v2:status": "node scripts/db-v2.mjs status",
    "setup:v2": "node scripts/setup-v2.mjs",
    "seed": "curl -X POST http://localhost:3000/api/seed",
    "test:model": "npx --yes tsx scripts/verify-td-model.ts",
    "backtest": "npx --yes tsx scripts/backtest-td-pool.ts",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "ios:assets": "capacitor-assets generate --ios --assetPath native/assets --iosProject ios/App",
    "ios:artwork": "swift native/make-artwork.swift"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "ai": "^7.0.93",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^59.11.7"
  }
}
